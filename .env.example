# pr-manager reads its configuration from a TOML file (default
# `./pr-manager.toml` in the working directory; override with `--config <path>`
# or `PR_MANAGER_CONFIG=<path>`).
#
# This `.env` is just for the GitHub tokens, which the TOML file references by
# env var name (default `GITHUB_TOKEN`; override per-repo via `token_env`).
# pr-manager loads `.env` via dotenv at startup before resolving tokens.

# Default token used by every repo whose entry doesn't override `token_env`.
# Needs `repo:read` + `pulls:read` (or just run `gh auth token`).
GITHUB_TOKEN=ghp_replace_me

# Per-repo token overrides — only set these if the matching repo entry sets
# `token_env = "GITHUB_TOKEN_FOO"` etc.
# GITHUB_TOKEN_ACME=ghp_replace_me
# GITHUB_TOKEN_SPROCKETS=ghp_replace_me
